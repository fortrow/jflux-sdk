<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.fortrow</groupId>
  <artifactId>jflux</artifactId>
  <version>1.1.0</version>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <id>shade-meridiandb</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <outputFile>${project.build.directory}/jflux-meridiandb-${project.version}.jar</outputFile>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <excludes>
                  <exclude>com.telnyx.sdk:telnyx</exclude>
                </excludes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>com/fortrow/jflux/sms/**</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
          <execution>
            <id>shade-core</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <outputFile>${project.build.directory}/jflux-${project.version}-core.jar</outputFile>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <includes>
                  <include>com.google.code.gson:gson</include>
                  <include>com.googlecode.json-simple:json-simple</include>
                  <include>com.jsoftbiz:os-platform-finder</include>
                  <include>org.slf4j:slf4j-api</include>
                  <include>org.slf4j:slf4j-nop</include>
                </includes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>com.fortrow:jflux</artifact>
                  <includes>
                    <include>com/fortrow/jflux/console/**</include>
                    <include>com/fortrow/jflux/crypto/**</include>
                    <include>com/fortrow/jflux/encoding/**</include>
                    <include>com/fortrow/jflux/exceptions/**</include>
                    <include>com/fortrow/jflux/files/**</include>
                    <include>com/fortrow/jflux/json/**</include>
                    <include>com/fortrow/jflux/shell/**</include>
                    <include>com/fortrow/jflux/sockets/**</include>
                    <include>com/fortrow/jflux/stdout/**</include>
                    <include>com/fortrow/jflux/sys/**</include>
                    <include>com/fortrow/jflux/todash/**</include>
                    <include>com/fortrow/jflux/threading/**</include>
                    <include>com/fortrow/jflux/runtime/lib/**</include>
                    <include>com/fortrow/jflux/regex/**</include>
                    <include>com/fortrow/jflux/output/json/**</include>
                  </includes>
                </filter>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>com/fortrow/jflux/http/**</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
          <execution>
            <id>shade-db</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <outputFile>${project.build.directory}/jflux-${project.version}-db.jar</outputFile>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <includes>
                  <include>com.google.code.gson:gson</include>
                  <include>com.googlecode.json-simple:json-simple</include>
                  <include>com.jsoftbiz:os-platform-finder</include>
                  <include>org.slf4j:slf4j-api</include>
                  <include>org.slf4j:slf4j-nop</include>
                  <include>redis.clients:jedis</include>
                  <include>org.apache.commons:commons-pool2</include>
                  <include>org.json:json</include>
                  <include>com.mysql:mysql-connector-j</include>
                  <include>com.google.protobuf:protobuf-java</include>
                  <include>org.xerial:sqlite-jdbc</include>
                </includes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>com.fortrow:jflux</artifact>
                  <includes>
                    <include>com/fortrow/jflux/console/**</include>
                    <include>com/fortrow/jflux/crypto/**</include>
                    <include>com/fortrow/jflux/encoding/**</include>
                    <include>com/fortrow/jflux/exceptions/**</include>
                    <include>com/fortrow/jflux/files/**</include>
                    <include>com/fortrow/jflux/json/**</include>
                    <include>com/fortrow/jflux/shell/**</include>
                    <include>com/fortrow/jflux/sockets/**</include>
                    <include>com/fortrow/jflux/stdout/**</include>
                    <include>com/fortrow/jflux/sys/**</include>
                    <include>com/fortrow/jflux/todash/**</include>
                    <include>com/fortrow/jflux/db/**</include>
                    <include>com/fortrow/jflux/threading/**</include>
                    <include>com/fortrow/jflux/runtime/lib/**</include>
                    <include>com/fortrow/jflux/regex/**</include>
                    <include>com/fortrow/jflux/output/json/**</include>
                  </includes>
                </filter>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>com/fortrow/jflux/http/**</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
          <execution>
            <id>shade-http</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <outputFile>${project.build.directory}/jflux-${project.version}-http.jar</outputFile>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <includes>
                  <include>com.google.code.gson:gson</include>
                  <include>com.googlecode.json-simple:json-simple</include>
                  <include>com.jsoftbiz:os-platform-finder</include>
                  <include>org.slf4j:slf4j-api</include>
                  <include>org.slf4j:slf4j-nop</include>
                  <include>redis.clients:jedis</include>
                  <include>org.apache.commons:commons-pool2</include>
                  <include>org.json:json</include>
                  <include>com.mysql:mysql-connector-j</include>
                  <include>com.google.protobuf:protobuf-java</include>
                  <include>org.xerial:sqlite-jdbc</include>
                  <include>tech.kwik:flupke</include>
                  <include>tech.kwik:qpack</include>
                  <include>tech.kwik:kwik</include>
                  <include>tech.kwik:agent15</include>
                  <include>org.apache.httpcomponents:httpclient</include>
                  <include>org.apache.httpcomponents:httpcore</include>
                  <include>commons-logging:commons-logging</include>
                  <include>commons-codec:commons-codec</include>
                  <include>com.google.guava:guava</include>
                  <include>com.google.guava:failureaccess</include>
                  <include>com.google.guava:listenablefuture</include>
                </includes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>com.fortrow:jflux</artifact>
                  <includes>
                    <include>com/fortrow/jflux/console/**</include>
                    <include>com/fortrow/jflux/crypto/**</include>
                    <include>com/fortrow/jflux/encoding/**</include>
                    <include>com/fortrow/jflux/exceptions/**</include>
                    <include>com/fortrow/jflux/files/**</include>
                    <include>com/fortrow/jflux/json/**</include>
                    <include>com/fortrow/jflux/shell/**</include>
                    <include>com/fortrow/jflux/sockets/**</include>
                    <include>com/fortrow/jflux/stdout/**</include>
                    <include>com/fortrow/jflux/sys/**</include>
                    <include>com/fortrow/jflux/todash/**</include>
                    <include>com/fortrow/jflux/db/**</include>
                    <include>com/fortrow/jflux/http/**</include>
                    <include>com/fortrow/jflux/ssl/**</include>
                    <include>com/fortrow/jflux/threading/**</include>
                    <include>com/fortrow/jflux/runtime/lib/**</include>
                    <include>com/fortrow/jflux/regex/**</include>
                    <include>com/fortrow/jflux/output/json/**</include>
                  </includes>
                </filter>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <source>23</source>
          <target>23</target>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
    </plugins>
  </build>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>junit-jupiter-api</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
        <exclusion>
          <artifactId>junit-jupiter-params</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
        <exclusion>
          <artifactId>junit-jupiter-engine</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.jupiter.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws.java.sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.azure</groupId>
        <artifactId>azure-sdk-bom</artifactId>
        <version>${azure.sdk.bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <properties>
    <maven.compiler.target>23</maven.compiler.target>
    <aws.java.sdk.version>2.42.35</aws.java.sdk.version>
    <maven.compiler.source>23</maven.compiler.source>
    <google.cloud.storage.version>2.67.0</google.cloud.storage.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.jupiter.version>5.11.4</junit.jupiter.version>
    <azure.sdk.bom.version>1.3.4</azure.sdk.bom.version>
  </properties>
</project>
